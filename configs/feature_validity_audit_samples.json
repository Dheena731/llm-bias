{
  "description": "Small manual audit set for checking feature extractor behavior before paper-grade claims.",
  "samples": [
    {
      "sample_id": "text_plain_prose",
      "track": "text",
      "content": "Plain prose without decorative formatting.",
      "expected": {
        "has_markdown": false,
        "has_format_default": false
      }
    },
    {
      "sample_id": "text_markdown_heading_list",
      "track": "text",
      "content": "## Launch note\n- Account filters are available now.",
      "expected": {
        "has_markdown": true,
        "has_format_default": true
      }
    },
    {
      "sample_id": "ui_blue_centered_card",
      "track": "ui",
      "content": "<section class=\"card\" style=\"color:#2563EB; text-align: center; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.12)\"><h1>Status</h1></section>",
      "expected": {
        "has_purple_or_blue": true,
        "has_centered_layout": true,
        "has_shadow": true
      }
    },
    {
      "sample_id": "ui_plain_form",
      "track": "ui",
      "content": "<form style=\"color:#222222\"><label>Status</label><input value=\"open\"></form>",
      "expected": {
        "has_purple_or_blue": false,
        "has_gradient": false,
        "has_rounded_cards": false,
        "has_shadow": false
      }
    },
    {
      "sample_id": "image_blue_bands",
      "track": "image",
      "image_spec": {
        "kind": "horizontal_bands",
        "size": [64, 48],
        "colors": ["#1D4ED8", "#93C5FD"]
      },
      "expected": {
        "has_purple_or_blue": true
      }
    },
    {
      "sample_id": "image_gray_solid",
      "track": "image",
      "image_spec": {
        "kind": "solid",
        "size": [64, 48],
        "colors": ["#808080"]
      },
      "expected": {
        "has_purple_or_blue": false
      }
    }
  ]
}
